# 설명용입니다. 자동으로 로드하지 않습니다. 실제 키는 쓰지 마세요.
TIMELY_API_KEY=
TIMELY_MODEL=openai/gpt-5.6-luna

TIMELY_BASE_URL=https://hello.timelyai.io/api/v2/chat/bridge/openai

# DB URLs/passwords and recovery key belong only to server environment.
WEMEET_GOAL_DATABASE_URL=
WEMEET_GOAL_ADMIN_DATABASE_URL=
WEMEET_RECOVERY_KEY=

# New backend (src/wemeet_backend). Separate from WEMEET_GOAL_DATABASE_URL.
WEMEET_AUTH_DATABASE_URL=

# API docs (/docs, /openapi.json) are OFF by default. For local development only,
# e.g. to share the API spec with the frontend, turn them on in your own terminal:
#   PowerShell:  $env:WEMEET_ENABLE_DOCS = "true"
# Never enable this in production.
WEMEET_ENABLE_DOCS=

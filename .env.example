# Copy to .env (never commit). Values below are local development placeholders.
MOIM_ENV=development
MOIM_DATABASE_URL=postgresql+psycopg://moim:CHANGE_ME@127.0.0.1:54329/moim_dev
# Tests use a separate database whose name must end with _test.
MOIM_TEST_DATABASE_URL=postgresql+psycopg://moim:CHANGE_ME@127.0.0.1:54329/moim_test
# Ed25519 key that signs confirmed todos (docs/SECURITY.md 6). start-moim.cmd creates one if missing.
# Make one by hand: python -m moim.signing new-key. Keep it out of the database and backups; losing it means old
# confirmations can no longer be verified (put its public key in MOIM_SIGNING_OLD_PUBLIC_KEYS when rotating).
MOIM_SIGNING_KEY=
# MOIM_SIGNING_OLD_PUBLIC_KEYS=

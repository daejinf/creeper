      "type": "string"
    },
    "data": {
      "default": null,
      "title": "Data"
    },
    "needed_inputs": {
      "items": {
        "type": "string"
      },
      "title": "Needed Inputs",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "persistence": {
      "additionalProperties": true,
      "title": "Persistence",
      "type": "object"
    }
  },
  "required": [
    "meta"
  ],
  "title": "Result",
  "type": "object"
}
          "title": "Run Id",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "prompt_version": {
          "default": "CODE",
          "title": "Prompt Version",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "transport_attempts": {
          "default": 0,
          "title": "Transport Attempts",
          "type": "integer"
        },
        "repair_attempts": {
          "default": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "output_expansions": {
          "default": 0,
          "title": "Output Expansions",
          "type": "integer"
        },
        "provider_request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Provider Request Ids",
          "type": "array"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "execution_source": {
          "default": "CODE",
          "enum": [
            "LIVE",
            "CODE",
            "REUSED"
          ],
          "title": "Execution Source",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "task"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "default": "OK",
      "enum": [
        "OK",
        "NEEDS_INPUT",
        "FAILED"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleContext",
  "description": "reader.context의 최소 후속 모듈 입력. 대화 원문과 개발자 로그를 포함하지 않습니다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "enum": [
        "GROUP",
        "PERSONAL"
      ]
    },
    "group_id": {
      "type": "string"
    },
    "owner_member_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_revision": {
      "type": "integer"
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "personal_goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "goal": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "title": {
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "start_date": {
              "format": "date",
              "title": "Start Date",
              "type": "string"
            },
            "end_date": {
              "format": "date",
              "title": "End Date",
              "type": "string"
            },
            "completion_criteria": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Completion Criteria",
              "type": "array"
            },
            "execution_method": {
              "minLength": 1,
              "title": "Execution Method",
              "type": "string"
            },
            "verification_method": {
              "minLength": 1,
              "title": "Verification Method",
              "type": "string"
            },
            "privacy_scope": {
              "default": "OBJECTIVE_ONLY",
              "enum": [
                "OBJECTIVE_ONLY",
                "PRIVATE"
              ],
              "title": "Privacy Scope",
              "type": "string"
            },
            "roles": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Roles",
              "type": "object"
            }
          },
          "required": [
            "title",
            "start_date",
            "end_date",
            "completion_criteria",
            "execution_method",
            "verification_method",
            "roles"
          ],
          "title": "Goal",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "contribution": {
      "type": [
        "object",
        "null"
      ]
    },
    "confirmed_conditions": {
      "type": "object",
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "default": null,
            "title": "Value"
          },
          "status": {
            "default": "UNKNOWN",
            "enum": [
              "KNOWN",
              "UNKNOWN",
              "SKIPPED",
              "SUGGESTED"
            ],
            "title": "Status",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Refs",
            "type": "array"
          }
        },
        "title": "PersonalField",
        "type": "object"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "default": "",
            "description": "이 응답 안의 고유한 임시 작업 ID(예: t1). 서버가 정식 ID로 변환합니다.",
            "title": "Task Id",
            "type": "string"
          },
          "owner_member_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Owner Member Id"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "deliverable": {
            "minLength": 1,
            "title": "Deliverable",
            "type": "string"
          },
          "due_date": {
            "description": "결과물을 완료해야 하는 기한",
            "format": "date",
            "title": "Due Date",
            "type": "string"
          },
          "scheduled_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "실제 수행 예정일. 미지정인 기존 계획은 due_date를 수행일로 해석합니다. 수행일은 기한을 넘을 수 없습니다.",
            "title": "Scheduled Date"
          },
          "estimated_minutes": {
            "exclusiveMinimum": 0,
            "title": "Estimated Minutes",
            "type": "integer"
          },
          "completion_criteria": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Completion Criteria",
            "type": "array"
          },
          "difficulty": {
            "default": "MEDIUM",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ],
            "title": "Difficulty",
            "type": "string"
          },
          "dependencies": {
            "description": "이 응답 tasks에 실제 존재하는 task_id만 참조합니다. 공동 원본 작업 ID나 제목을 넣지 않습니다.",
            "items": {
              "type": "string"
            },
            "title": "Dependencies",
            "type": "array"
          }
        },
        "required": [
          "title",
          "deliverable",
          "due_date",
          "estimated_minutes",
          "completion_criteria"
        ],
        "title": "Task",
        "type": "object"
      }
    },
    "input_versions": {
      "type": "object"
    },
    "is_current": {
      "type": "boolean"
    },
    "requires_review": {
      "type": "boolean"
    },
    "readiness": {
      "enum": [
        "READY",
        "NEEDS_INPUT",
        "REVIEW_REQUIRED"
      ]
    },
    "needed_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "group_id",
    "owner_member_id",
    "record_revision",
    "goal_id",
    "personal_goal_id",
    "plan_version_id",
    "baseline_id",
    "goal",
    "contribution",
    "confirmed_conditions",
    "tasks",
    "input_versions",
    "is_current",
    "requires_review",
    "readiness",
    "needed_inputs"
  ]
}